# FastAPI ML service
ML_API_HOST=0.0.0.0
ML_API_PORT=8000
ML_API_KEY=dev-key-change-me
LOG_LEVEL=INFO

# Model paths (relative to ml-api/)
MODEL_PATH=./models/isolation_forest.joblib
SCALER_PATH=./models/scaler.joblib
METADATA_PATH=./models/feature_metadata.json

# Supabase (optional — for /train/from-db and trusted history fetch)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hybrid scoring weights
RULE_WEIGHT=0.4
ML_WEIGHT=0.6
ANOMALY_THRESHOLD=60
TRUSTED_RISK_THRESHOLD=30
